# LNX Monitor -- Docker Compose settings.
#
# Copy to `.env` next to compose.yaml. Every value is optional: compose.yaml
# ships a working default for each one, so an empty file (or no file) also works.

# Image tag to run. Use a release tag (e.g. 1.2.0) to pin a version.
MONITOR_VERSION=latest

# Host port the web UI is published on.
APP_PORT=8080

# Public URL the app is reached at. Used in emails and generated links.
APP_URL=http://localhost:8080

# Leave blank to have the container generate a key on first start and persist it
# in the storage volume. Set it to reuse an existing key (php artisan key:generate --show).
APP_KEY=

APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info

# MySQL credentials. Change these before exposing the stack to a network.
DB_DATABASE=monitor
DB_USERNAME=monitor
DB_PASSWORD=monitor
DB_ROOT_PASSWORD=monitor-root

# Outbound mail for alerts and notifications. `log` writes mail to the container log.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=monitor@lnxinc.com
MAIL_FROM_NAME="LNX Monitor"

# UniFi Site Manager integration (optional).
UNIFI_SITE_MANAGER_BASE_URL=https://api.ui.com/v1
UNIFI_SITE_MANAGER_API_KEY=

# Reliability tuning (optional). See README for what each one does.
HEARTBEAT_MAX_ATTEMPTS=3
HEARTBEAT_INITIAL_BACKOFF_MS=200
HEARTBEAT_BACKOFF_MULTIPLIER=2.0
ALERT_DEDUPE_TTL_SECONDS=300
ALERT_FLOOD_LIMIT=10
ALERT_FLOOD_WINDOW_SECONDS=60

PHP_MEMORY_LIMIT=256M
